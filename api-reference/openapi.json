{
  "openapi": "3.0.3",
  "info": {
    "title": "FireFlo OMNI API",
    "version": "1.0.0",
    "description": "One API for every channel and service in FireFlo OMNI."
  },
  "paths": {
    "/v1/calls": {
      "get": {
        "operationId": "list_calls",
        "description": "The account's calls, newest first, whichever way they went. Filter by direction (inbound or outbound), status (dialling, started, ended, failed or missed), kind, or contact (a contact's id).",
        "tags": [
          "calls"
        ],
        "responses": {
          "200": {
            "description": "No response body"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "operationId": "place_call",
        "description": "Ring someone into one of your IVRs or have a voice agent call them (target from GET /v1/calls/targets). Screened like any message: refused with not_permitted when their consent doesn't allow it. Answers 202 with the call; its status moves on as it is answered and ends.",
        "tags": [
          "calls"
        ],
        "responses": {
          "200": {
            "description": "No response body"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/calls/{call_id}": {
      "get": {
        "operationId": "get_call",
        "description": "One call: who, which way, how it ended and how long it lasted, and for a voice agent's call what was said and its summary.",
        "parameters": [
          {
            "in": "path",
            "name": "call_id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "tags": [
          "calls"
        ],
        "responses": {
          "200": {
            "description": "No response body"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/calls/targets": {
      "get": {
        "operationId": "list_call_targets",
