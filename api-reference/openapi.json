        "security": [
          {
            "bearer": []
          }
        ]
      },
      "patch": {
        "operationId": "whatsapp_edit_template",
        "description": "Change a template's body, footer or category. Meta reviews every edit: it is pending, and can't be sent, until approved again.",
        "parameters": [
          {
            "in": "path",
            "name": "template_id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "tags": [
          "channels"
        ],
        "responses": {
          "200": {
            "description": "No response body"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "delete": {
        "operationId": "whatsapp_delete_template",
        "description": "Delete a template in this one language.",
        "parameters": [
          {
            "in": "path",
            "name": "template_id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "tags": [
          "channels"
        ],
        "responses": {
          "204": {
            "description": "No response body"
          }
        },
        "security": [
          {
            "bearer": []
          }
