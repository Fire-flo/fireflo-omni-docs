          {
            "in": "path",
            "name": "registration_id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "tags": [
          "channels"
        ],
        "responses": {
          "204": {
            "description": "No response body"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/channels/whatsapp/templates": {
      "get": {
        "operationId": "whatsapp_list_templates",
