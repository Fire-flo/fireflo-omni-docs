        "parameters": [
          {
            "in": "path",
            "name": "contact_id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "tags": [
          "conversations"
        ],
        "responses": {
          "200": {
            "description": "No response body"
