          "channels"
        ],
        "responses": {
          "200": {
            "description": "No response body"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "operationId": "whatsapp_submit_template",
        "description": "Submit a template for Meta's approval: name (lower case, digits and underscores), category (utility, marketing or authentication), language, body with {{1}}-style values, and optional header_text and footer. It is pending until Meta decides.",
